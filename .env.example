# Copy to .env and fill in. .env is git-ignored.

# --- Script writer (LLM) ---
# If GEMINI_API_KEY is set the pipeline uses Gemini, otherwise a local Ollama model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Comma-separated models tried in order when the primary one returns 503/404.
GEMINI_FALLBACKS=
# BRAIN_BACKEND=gemini|ollama   (optional override)
BRAIN_MODEL=qwen2.5:7b

# --- Visual sources ---
PIXABAY_API_KEY=
# Optional
PEXELS_API_KEY=
RIJKS_API_KEY=
# Wikimedia asks API clients for a contact address in the User-Agent.
CONTACT_EMAIL=

# --- Paths (optional, defaults are relative to the repo) ---
# SHORTS_ASSETS_DIR=
# SHORTS_OUT_DIR=
# PIPER_DIR=

# --- Rendering (optional) ---
# SHORTS_TTS_RATE=-8%
# SHORTS_HUD=1
# SHORTS_CAPTION_STYLE=box      # box | karaoke
# SHORTS_MIN_ALAKA=0.80         # quality gate: share of beats whose visual matched its query
# SHORTS_MIN_FARKLI=0.60        # quality gate: distinct visuals / beats
